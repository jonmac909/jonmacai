FROM node:22-bookworm
WORKDIR /app
# Chrome refuses its sandbox as root; inside this throwaway container the container is the boundary.
ENV CHROME_NO_SANDBOX=1
COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chrome && npm install --global wrangler@4.145.0
COPY . .
CMD ["node", "scripts/docker-checks.mjs"]
