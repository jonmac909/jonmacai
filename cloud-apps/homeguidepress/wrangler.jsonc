{
  // homeguidepress.com: Home Guide Press landing pages + Commas webhook + Resend delivery (JON-59).
  // Secrets (wrangler secret put, never committed): COMMAS_WEBHOOK_SECRET, RESEND_API_KEY, LINK_SECRET,
  // COMMAS_TEST_WEBHOOK_SECRET (signed test webhooks only; delete it to switch the test path off).
  "name": "homeguidepress",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": true,
  "triggers": { "crons": ["*/10 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "SITE_URL": "https://homeguidepress.com",
    "RESEND_FROM_ADDRESS": "books@homeguidepress.com",
    // "true" once Ana says a product is live; until then every page is noindex and robots.txt disallows all.
    "INDEXING": "true",
    // Commas checkout link per product key, from the ebook worker's JON-59 comment. Empty = "Checkout opens soon".
    "CHECKOUT_URLS": "{\"angelo\":\"https://commas.com/checkout/Lk9LDxcaJCIxyWWY4\",\"steve\":\"https://commas.com/checkout/Ml8MmvJ7nwKEGNl\",\"gary\":\"https://commas.com/checkout/BJBxQtTbT1fEqzod\",\"prepared\":\"https://commas.com/checkout/DLkz6c7lnV622Va5\",\"rosa-cooks\":\"https://commas.com/checkout/EMRAWdbHwHulNoDW\",\"rosa-hacks\":\"https://commas.com/checkout/Jg6JKzGVdCkAk0S46\",\"rosa-clean\":\"https://commas.com/checkout/GO6DKiN8vFg3Ea\",\"dale\":\"https://commas.com/checkout/OnYOReOa5aFpxN\",\"ruth\":\"https://commas.com/checkout/NmkN23NPqz11xD\",\"gail\":\"https://commas.com/checkout/QpWQGRagHFnX6vx\",\"nora\":\"https://commas.com/checkout/PoNPAljDMjTcM\",\"naomi\":\"https://commas.com/checkout/Rq6RVx2Btw0OD\",\"walter\":\"https://commas.com/checkout/VxOYzKFLbB4Oqlu\",\"helen\":\"https://commas.com/checkout/Wy6ZEOizAXTLDCi\",\"helenwalter\":\"https://commas.com/checkout/XzD1vpVLC5Sfx\",\"diane\":\"https://commas.com/checkout/1A150k6AKQ2XaV\",\"eleanor\":\"https://commas.com/checkout/jmXBludv00ELgb2\"}",
    // Commas product ID per key, if the ID isn't the start of the checkout link path.
    "PRODUCT_IDS": "{\"angelo\":\"Lk9LDxcaJCIxyWWY4\",\"steve\":\"Ml8MmvJ7nwKEGNl\",\"gary\":\"BJBxQtTbT1fEqzod\",\"prepared\":\"DLkz6c7lnV622Va5\",\"rosa-cooks\":\"EMRAWdbHwHulNoDW\",\"rosa-hacks\":\"Jg6JKzGVdCkAk0S46\",\"rosa-clean\":\"GO6DKiN8vFg3Ea\",\"dale\":\"OnYOReOa5aFpxN\",\"ruth\":\"NmkN23NPqz11xD\",\"gail\":\"QpWQGRagHFnX6vx\",\"nora\":\"PoNPAljDMjTcM\",\"naomi\":\"Rq6RVx2Btw0OD\",\"walter\":\"VxOYzKFLbB4Oqlu\",\"helen\":\"Wy6ZEOizAXTLDCi\",\"helenwalter\":\"XzD1vpVLC5Sfx\",\"diane\":\"1A150k6AKQ2XaV\",\"eleanor\":\"jmXBludv00ELgb2\"}",
    // Optional per-key file list override: {"steve":[{"name":"...pdf","object":"steve/....pdf"}]}.
    "FILES": "{}",
    // Signed test webhooks may only email these addresses (never Jon's inbox).
    "TEST_RECIPIENTS": "delivered@resend.dev"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "homeguidepress", "database_id": "3d74fd02-98ef-45ff-b6ec-5a9848d8c9fb", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "BOOKS", "bucket_name": "homeguidepress-books" }
  ],
  "routes": [
    { "pattern": "homeguidepress.com", "custom_domain": true },
    { "pattern": "www.homeguidepress.com", "custom_domain": true }
  ]
}
