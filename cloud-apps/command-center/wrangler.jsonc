{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonmac-command-center",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }, // console.error only: request URLs carry OAuth codes
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command_center",
      "database_id": "615b0a5a-10b5-42d8-b127-9f4af3198104"
    },
    {
      "binding": "REVIEW_DB",
      "database_name": "jonmac-review",
      "database_id": "aaf91d9f-48f9-458a-aa6d-24354266a39b"
    },
    {
      "binding": "CLONE_DB",
      "database_name": "jonmacai-clone-upsells",
      "database_id": "cafcc654-94e7-498c-81cf-e197393c1176"
    },
    // Track: book-page visits and paid orders per channel (src/track.js). Read only.
    {
      "binding": "HGP_DB",
      "database_name": "homeguidepress",
      "database_id": "3d74fd02-98ef-45ff-b6ec-5a9848d8c9fb"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "command-center-uploads"
    }
  ],
  // /dashboard/review: Jon's requests go to the review Worker with the REVIEW_API_TOKEN secret (src/videoreview.js).
  // APEX: the jonmac.ai site worker, asked whether a new Skool slug is already a page (src/skoolroutes.js).
  "services": [
    { "binding": "REVIEW", "service": "jonmac-review" },
    { "binding": "APEX", "service": "elevateapp" }
  ],
  // Skool slug routes (src/skoolroutes.js): written only here (ROUTES_LIVE "1"), with secret CF_ROUTES_TOKEN (Zone > Workers Routes > Edit, jonmac.ai).
  "vars": { "CF_ZONE_ID": "8f58dee14f7fc0e66494d6278aec53aa", "ROUTES_LIVE": "1" },
  "triggers": {
    "crons": ["*/10 * * * *", "*/15 * * * *"]
  },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Phone calls to Ana (src/call.js): GPU1 and Jon's phone meet in one Durable Object.
  // Secret CALL_RELAY_SECRET = D:\AgentTeam\secrets\call-relay.secret on GPU1.
  "durable_objects": {
    "bindings": [
      { "name": "CALL_RELAY", "class_name": "CallRelay" },
      // Live GPU Monitor (src/monitor.js): latest GPU1/GPU2 sample. Secret MONITOR_PUSH_SECRET = D:\AgentTeam\secrets\monitor-push.secret.
      { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
    ]
  },
  "migrations": [
    { "tag": "call-relay-v1", "new_sqlite_classes": ["CallRelay"] },
    { "tag": "gpu-monitor-v1", "new_sqlite_classes": ["GpuMonitor"] }
  ],
  "routes": [
    { "pattern": "jonmac.ai/dashboard", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/dashboard/*", "zone_name": "jonmac.ai" },
    // Dashboard 2 (docs/dashboard-2.md).
    { "pattern": "jonmac.ai/dashboard-2", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/dashboard-2/*", "zone_name": "jonmac.ai" },
    // Dashboard 3 (docs/dashboard-3.md).
    { "pattern": "jonmac.ai/dash", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/dash/*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/jacq", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/jacq/*", "zone_name": "jonmac.ai" },
    // Private script review pages from R2 private/scripts/, signed in only (src/worker.js).
    { "pattern": "jonmac.ai/scripts", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/scripts/*", "zone_name": "jonmac.ai" },
    // Tracked video links (src/track.js).
    { "pattern": "jonmac.ai/v/*", "zone_name": "jonmac.ai" },
    // Skool short links and tracker (src/skool.js). Secret SKOOL_ZAP_TOKEN = D:\AgentTeam\secrets\skool-zap.token.
    // Skool email sequence (src/skoolseq.js, off until Jon switches it on): secrets RESEND_API_KEY and RESEND_WEBHOOK_SECRET (Resend webhook to https://jonmac.ai/track/api/resend);
    // optional vars SKOOL_FROM, SKOOL_REPLY_TO, SKOOL_BUSINESS and SKOOL_ADDRESS (the real mailing address: real sends stay paused while it is unset).
    { "pattern": "jonmac.ai/s/*", "zone_name": "jonmac.ai" },
    // Skool tracker links at the root (Jon 2026-11-21): one route per slug, the apex site owns every other path
    { "pattern": "jonmac.ai/ai-agents-hacking", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/astra-seedance", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/astra-ugc-ads", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/astra62-test", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/claude-editing", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/fable52-motion", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/fb*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/ig*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/ig-affiliate-page", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/jonmacbiz", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/li*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/macframes", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/mythos52", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/tt*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/x*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/youtube*", "zone_name": "jonmac.ai" },
    // One-word video links (src/skoolroutes.js SHORT_LINKS): wildcard like the social ones; other paths under the word pass to the main site.
    // More words are data, not code: POST https://jonmac.ai/track/api/words (src/skoolwords.js) stores them in D1 skool_words and makes their
    // jonmac.ai/<word>* route by API (re-made after each deploy). Secret LINK_REGISTER_TOKEN = D:\AgentTeam\secrets\link-register.token on GPU1.
    { "pattern": "jonmac.ai/neon*", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/track", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/track/*", "zone_name": "jonmac.ai" },
    // Live GPU Monitor (src/monitor.js).
    { "pattern": "jonmac.ai/monitor", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/monitor/*", "zone_name": "jonmac.ai" },
    // Ana phones Jon (src/twilioanswer.js): Twilio posts the keypad answer here. Worker secret TWILIO_AUTH_TOKEN (signature check).
    { "pattern": "jonmac.ai/twilio/*", "zone_name": "jonmac.ai" }
  ],
  // Preview: `wrangler deploy --env preview`. Separate Worker on workers.dev with its own D1,
  // no routes, no cron, no review/funnel D1s, no production R2 and no production secrets (only a
  // preview-only SESSION_SECRET for the smoke test). Live data is never touched.
  // Proof files on preview go to their own bucket, command-center-uploads-preview.
  "env": {
    "preview": {
      "name": "jonmac-command-center-preview",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    },
    // Per-card preview for Skool slug auto-routes: APEX check is real, route writes dry-run (no ROUTES_LIVE, no token).
    "preview-track-autoroute": {
      "name": "jonmac-cc-preview-track-autoroute",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1", "CF_ZONE_ID": "8f58dee14f7fc0e66494d6278aec53aa" },
      "services": [{ "binding": "APEX", "service": "elevateapp" }],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    },
    // Per-card preview for the EOS page (card t_75395eabd6774bdc): same bindings as env.preview.
    "preview-eos": {
      "name": "jonmac-cc-preview-eos",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    },
    // Per-card preview for Skool landers -> skool.com/ai-ugc/about (Jon 2026-11-25): same bindings as env.preview.
    "preview-skool-about": {
      "name": "jonmac-cc-preview-skool-about",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    },
    // Per-card preview for OpenBot reminders on Home (card t_b57896651c1c478a): same bindings as env.preview, own Worker.
    "preview-reminders": {
      "name": "jonmac-cc-preview-reminders",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    },
    "preview-budget": {
      "name": "jonmac-cc-preview-budget",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "triggers": { "crons": [] },
      "vars": { "PREVIEW": "1" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "CALL_RELAY", "class_name": "CallRelay" },
          { "name": "GPU_MONITOR", "class_name": "GpuMonitor" }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "command_center_preview",
          "database_id": "cf929245-7de2-4fc6-85bf-e3f02c187e6a"
        }
      ],
      "r2_buckets": [
        { "binding": "UPLOADS", "bucket_name": "command-center-uploads-preview" }
      ]
    }
  }
}
