{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jonmac-command-center",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "command_center",
      "database_id": "615b0a5a-10b5-42d8-b127-9f4af3198104"
    },
    {
      "binding": "REVIEW_DB",
      "database_name": "jonmac-review",
      "database_id": "aaf91d9f-48f9-458a-aa6d-24354266a39b"
    },
    {
      "binding": "CLONE_DB",
      "database_name": "jonmacai-clone-upsells",
      "database_id": "cafcc654-94e7-498c-81cf-e197393c1176"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "command-center-uploads"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "routes": [
    { "pattern": "jonmac.ai/dashboard", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/dashboard/*", "zone_name": "jonmac.ai" }
  ]
}
