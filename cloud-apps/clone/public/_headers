# filenames are content-hashed, so they can never go stale
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/upsells.js
  Cache-Control: no-cache

/checkout-handoff.js
  Cache-Control: no-cache

/whop-pixel.js
  Cache-Control: no-cache

/schedule.js
  Cache-Control: no-cache
