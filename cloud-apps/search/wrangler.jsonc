{
  "name": "jonmac-search",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "jonmac.ai/search", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/search/*", "zone_name": "jonmac.ai" }
  ]
}
