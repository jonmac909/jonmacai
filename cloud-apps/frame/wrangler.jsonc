{
  "name": "jonmac-freeframe",
  "main": "worker.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "COMMENTS",
      "id": "e002e928ac1d4816b69596f3e7d40acd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "frame-media"
    }
  ],
  "routes": [
    { "pattern": "jonmac.ai/frame", "zone_name": "jonmac.ai" },
    { "pattern": "jonmac.ai/frame/*", "zone_name": "jonmac.ai" }
  ]
}
